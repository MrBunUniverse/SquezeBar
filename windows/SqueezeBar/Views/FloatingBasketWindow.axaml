<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqueezeBar.Views.FloatingBasketWindow"
        Title="SqueezeBar Floating Basket"
        Width="80" Height="80"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#16181D"
        Foreground="White"
        DragDrop.AllowDrop="True">

    <Border Width="68" Height="68"
            CornerRadius="12"
            Background="#20242E"
            BorderBrush="#00D2FF"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
            <Border Width="20" Height="20" CornerRadius="5" Background="#00D2FF" HorizontalAlignment="Center">
                <TextBlock Text="S" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="DROP" FontSize="8.5" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
