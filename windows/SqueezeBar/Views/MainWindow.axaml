<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SqueezeBar.Models"
        xmlns:services="clr-namespace:SqueezeBar.Services"
        x:Class="SqueezeBar.Views.MainWindow"
        Title="SqueezeBar"
        Width="430" Height="700"
        CanResize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1E"
        Foreground="#E8E8ED">

    <!-- ── Frosted Glass Window Container ── -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 1. HEADER — Minimal, Typographic, Serif-Inspired    -->
        <!-- ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,0">
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="SqueezeBar" FontSize="14" FontWeight="Bold" Foreground="#F0F0F5" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <TextBlock Text="Universal Media Optimizer" FontSize="9" Foreground="#6B6B78"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="ProcessingBadge" Background="#1A2E28" CornerRadius="10" Padding="8,3" IsVisible="False">
                    <TextBlock Text="Optimizing..." FontSize="9" FontWeight="SemiBold" Foreground="#4ADE80"/>
                </Border>
                <!-- Floating Ball -->
                <Button x:Name="FloatingBallBtn" Padding="0" Background="Transparent" BorderThickness="0" Click="ToggleFloatingBall_Click">
                    <Border Background="#FFFFFF0A" CornerRadius="12" Padding="8,4" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                        <TextBlock Text="Floating Ball" FontSize="9.5" FontWeight="Medium" Foreground="#A0A0B0"/>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 2. TAB GLIDER BAR — Frosted Glass Capsule           -->
        <!-- ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#00000040" CornerRadius="20" Margin="20,12,20,0" Padding="3" BorderBrush="#FFFFFF14" BorderThickness="0.5">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Activity Pill -->
                <Button Grid.Column="0" x:Name="ActivityTabBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,7" CornerRadius="17" Background="#FFFFFF18" BorderBrush="#FFFFFF2A" BorderThickness="0.5" Click="ActivityTab_Click">
                    <TextBlock Text="Activity" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0F0F5"/>
                </Button>

                <!-- Settings Circle -->
                <Button Grid.Column="1" x:Name="SettingsTabBtn" Width="32" Height="32" CornerRadius="16" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsTab_Click">
                    <TextBlock Text="⚙" FontSize="13" Foreground="#6B6B78" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 3. MAIN SCROLLABLE CONTENT                          -->
        <!-- ════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Spacing="10" Margin="18,0,18,18">

                <!-- ━━━━━━━━━━━━ ACTIVITY TAB ━━━━━━━━━━━━ -->
                <StackPanel x:Name="ActivityTabPanel" Spacing="10">

                    <!-- ── 4 Live Format Profile Tiles ── -->
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Images -->
                        <Button Grid.Column="0" Margin="0,0,3,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Click="SelectImagesCategory_Click">
                            <Border x:Name="ImagesTileBorder" Background="#FFFFFF09" CornerRadius="9" Padding="8,9" MinHeight="62" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Images" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                        <TextBlock Grid.Column="1" x:Name="ImagesChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                    </Grid>
                                    <TextBlock x:Name="ImagesTileFormat" Text="WebP" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                    <TextBlock x:Name="ImagesTileQuality" Text="80% Q · 100%" FontSize="8" Foreground="#6B6B78"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Video -->
                        <Button Grid.Column="1" Margin="2,0,2,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Click="SelectVideoCategory_Click">
                            <Border x:Name="VideoTileBorder" Background="#FFFFFF09" CornerRadius="9" Padding="8,9" MinHeight="62" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Video" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                        <TextBlock Grid.Column="1" x:Name="VideoChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                    </Grid>
                                    <TextBlock x:Name="VideoTileCodec" Text="HEVC" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                    <TextBlock x:Name="VideoTileQuality" Text="70% Q · 100%" FontSize="8" Foreground="#6B6B78"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Audio -->
                        <Button Grid.Column="2" Margin="2,0,2,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Click="SelectAudioCategory_Click">
                            <Border x:Name="AudioTileBorder" Background="#FFFFFF09" CornerRadius="9" Padding="8,9" MinHeight="62" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Audio" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                        <TextBlock Grid.Column="1" x:Name="AudioChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                    </Grid>
                                    <TextBlock x:Name="AudioTileBitrate" Text="192 kbps" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                    <TextBlock Text="AAC Stereo" FontSize="8" Foreground="#6B6B78"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- PDF -->
                        <Button Grid.Column="3" Margin="3,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Click="SelectPdfCategory_Click">
                            <Border x:Name="PdfTileBorder" Background="#FFFFFF09" CornerRadius="9" Padding="8,9" MinHeight="62" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="PDF" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                        <TextBlock Grid.Column="1" x:Name="PdfChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                    </Grid>
                                    <TextBlock x:Name="PdfTileDpi" Text="150 DPI" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                    <TextBlock Text="Optimized" FontSize="8" Foreground="#6B6B78"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- ── Collapsible Format Configuration Deck ── -->
                    <Border x:Name="FormatDrawerBorder" Background="#FFFFFF06" CornerRadius="10" Padding="12" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                        <StackPanel Spacing="10">

                            <!-- Target Size Limit -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="TARGET SIZE LIMIT" FontSize="9" FontWeight="Bold" Foreground="#6B6B78" FontFamily="Georgia, 'Times New Roman', serif"/>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" x:Name="PresetOffBtn" Content="Manual" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="PresetOff_Click"/>
                                    <Button Grid.Column="1" x:Name="Preset25Btn" Content="25 MB" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" FontWeight="SemiBold" Background="#00D2FF" Foreground="#000000" CornerRadius="14" Padding="0,5" Click="Preset25_Click"/>
                                    <Button Grid.Column="2" x:Name="Preset10Btn" Content="10 MB" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="Preset10_Click"/>
                                    <Button Grid.Column="3" x:Name="Preset50Btn" Content="50 MB" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="Preset50_Click"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="#FFFFFF0E"/>

                            <!-- Images Deck -->
                            <StackPanel x:Name="ImagesDeckPanel" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Image Quality" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                    <TextBlock Grid.Column="1" x:Name="ImgQualityLabel" Text="80%" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                </Grid>
                                <Slider x:Name="ImgQualitySlider" Minimum="0.10" Maximum="1.0" Value="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="3">
                                        <TextBlock Text="Format" FontSize="9" Foreground="#6B6B78"/>
                                        <ComboBox x:Name="ImgFormatCombo" HorizontalAlignment="Stretch" FontSize="10" Background="#FFFFFF0A" BorderBrush="#FFFFFF14">
                                            <ComboBoxItem Content="WebP"/>
                                            <ComboBoxItem Content="JPEG"/>
                                            <ComboBoxItem Content="Original"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="3">
                                        <TextBlock Text="Resolution Scale" FontSize="9" Foreground="#6B6B78"/>
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" Content="100%" Margin="0,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="ImgScale100_Click"/>
                                            <Button Grid.Column="1" Content="75%" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="ImgScale75_Click"/>
                                            <Button Grid.Column="2" Content="50%" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="ImgScale50_Click"/>
                                            <Button Grid.Column="3" Content="25%" Margin="1,0,0,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="ImgScale25_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Video Deck -->
                            <StackPanel x:Name="VideoDeckPanel" Spacing="8" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Video Quality" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                    <TextBlock Grid.Column="1" x:Name="VidQualityLabel" Text="70%" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                </Grid>
                                <Slider x:Name="VidQualitySlider" Minimum="0.10" Maximum="1.0" Value="0.70" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="3">
                                        <TextBlock Text="Video Codec" FontSize="9" Foreground="#6B6B78"/>
                                        <ComboBox x:Name="VidCodecCombo" HorizontalAlignment="Stretch" FontSize="10" Background="#FFFFFF0A" BorderBrush="#FFFFFF14">
                                            <ComboBoxItem Content="HEVC (H.265)"/>
                                            <ComboBoxItem Content="H.264"/>
                                            <ComboBoxItem Content="Animated GIF"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="3">
                                        <TextBlock Text="Resolution Scale" FontSize="9" Foreground="#6B6B78"/>
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" Content="100%" Margin="0,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="VidScale100_Click"/>
                                            <Button Grid.Column="1" Content="75%" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="VidScale75_Click"/>
                                            <Button Grid.Column="2" Content="50%" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="VidScale50_Click"/>
                                            <Button Grid.Column="3" Content="25%" Margin="1,0,0,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="VidScale25_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Audio Deck -->
                            <StackPanel x:Name="AudioDeckPanel" Spacing="7" IsVisible="False">
                                <TextBlock Text="Audio Bitrate" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                <ComboBox x:Name="AudioBitrateCombo" HorizontalAlignment="Stretch" FontSize="10" Background="#FFFFFF0A" BorderBrush="#FFFFFF14">
                                    <ComboBoxItem Content="64 kbps · Voice"/>
                                    <ComboBoxItem Content="128 kbps · Standard"/>
                                    <ComboBoxItem Content="192 kbps · High Quality"/>
                                    <ComboBoxItem Content="256 kbps · Studio"/>
                                    <ComboBoxItem Content="320 kbps · Maximum"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- PDF Deck -->
                            <StackPanel x:Name="PdfDeckPanel" Spacing="7" IsVisible="False">
                                <TextBlock Text="PDF Target DPI" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Content="72" Margin="0,0,2,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="PdfDpi72_Click"/>
                                    <Button Grid.Column="1" Content="150" Margin="2,0,2,0" FontSize="9" FontWeight="SemiBold" Background="#00D2FF" Foreground="#000000" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="14" Padding="0,5" Click="PdfDpi150_Click"/>
                                    <Button Grid.Column="2" Content="200" Margin="2,0,2,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="PdfDpi200_Click"/>
                                    <Button Grid.Column="3" Content="300" Margin="2,0,0,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FFFFFF0A" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="PdfDpi300_Click"/>
                                </Grid>
                                <CheckBox x:Name="PdfGrayscaleCheck" Content="Convert to Grayscale" FontSize="10" Foreground="#A0A0B0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Quick Squeeze Drop Zone ── -->
                    <Border x:Name="QuickDropBorder"
                            Background="#FFFFFF06"
                            BorderBrush="#FFFFFF14"
                            BorderThickness="0.5"
                            CornerRadius="10"
                            Padding="18,14"
                            DragDrop.AllowDrop="True">
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="Drop files here for instant compression" FontSize="11" Foreground="#B0B0BE" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Border Background="#FFFFFF0A" CornerRadius="10" Padding="7,2.5" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                    <TextBlock x:Name="QuickDropLimitPill" Text="25 MB Limit" FontSize="8.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                </Border>
                                <Border Background="#FFFFFF0A" CornerRadius="10" Padding="7,2.5" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                    <TextBlock Text="WebP · HEVC · PDF" FontSize="8.5" Foreground="#6B6B78"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Staged Queue Section ── -->
                    <Border Background="#FFFFFF06"
                            BorderBrush="#FFFFFF0E"
                            BorderThickness="0.5"
                            CornerRadius="10"
                            Padding="12"
                            DragDrop.AllowDrop="True"
                            x:Name="StagedQueueBorder">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock x:Name="QueueHeaderTitle" Text="Staged Queue (0)" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Clear" FontSize="9" Background="Transparent" Foreground="#6B6B78" Padding="4,2" Margin="0,0,6,0" Click="ClearQueue_Click" BorderThickness="0"/>
                                <Button Grid.Column="2" x:Name="SqueezeAllBtn" Content="Squeeze All" FontSize="10" FontWeight="SemiBold" Background="#00D2FF" Foreground="#000000" CornerRadius="14" Padding="12,5" Click="SqueezeAll_Click"/>
                            </Grid>

                            <ItemsControl x:Name="StagedQueueItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:StagedQueueItem">
                                        <Border Background="#FFFFFF06" CornerRadius="8" Padding="9,7" Margin="0,2" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E8E8ED" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CustomSettingSummary}" FontSize="9" Foreground="#00D2FF"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Custom" FontSize="9" Background="#FFFFFF0A" Foreground="#B0B0BE" CornerRadius="4" Padding="6,3" Margin="4,0" BorderBrush="#FFFFFF14" BorderThickness="0.5" Click="CustomizeItem_Click" Tag="{Binding}"/>
                                                <Button Grid.Column="2" Content="✕" FontSize="9" Background="Transparent" Foreground="#55556A" Padding="4,2" Click="DeleteItem_Click" Tag="{Binding Id}" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="EmptyQueueHint" Text="Drag files here to customize per-file settings" FontSize="9.5" Foreground="#44444F" TextAlignment="Center" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Active Processing Jobs ── -->
                    <Border x:Name="ActiveJobsBorder" Background="#FFFFFF06" CornerRadius="10" Padding="12" BorderBrush="#FFFFFF0E" BorderThickness="0.5" IsVisible="False">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CURRENT QUEUE" FontSize="9" FontWeight="Bold" Foreground="#6B6B78" FontFamily="Georgia, 'Times New Roman', serif"/>
                                <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Click="CancelAllJobs_Click">
                                    <Border Background="#FF525218" CornerRadius="10" Padding="6,2.5" BorderBrush="#FF525240" BorderThickness="0.5">
                                        <TextBlock Text="Cancel All" FontSize="9" FontWeight="SemiBold" Foreground="#EF5350"/>
                                    </Border>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="ActiveJobsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:CompressionJob">
                                        <Border Background="#FFFFFF06" CornerRadius="8" Padding="9,7" Margin="0,2" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="Medium" Foreground="#E8E8ED" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="3" Background="#FFFFFF0A" Foreground="#00D2FF" CornerRadius="1.5"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#00D2FF18" CornerRadius="10" Padding="6,2" Margin="6,0,0,0" BorderBrush="#00D2FF30" BorderThickness="0.5">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="✕" FontSize="9" Background="Transparent" Foreground="#55556A" Padding="3,2" Click="CancelSingleJob_Click" Tag="{Binding Id}" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── Recent History ── -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="PROJECTS &amp; RECENT" FontSize="9" FontWeight="Bold" Foreground="#6B6B78" Margin="0,4,0,0" FontFamily="Georgia, 'Times New Roman', serif"/>

                        <ItemsControl x:Name="HistoryItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:CompressionResult">
                                    <Border Background="#FFFFFF06" CornerRadius="8" Padding="9,7" Margin="0,2" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding FormattedOriginalSize}" FontSize="8.5" Foreground="#55556A"/>
                                                    <TextBlock Text="→" FontSize="8.5" Foreground="#44444F"/>
                                                    <TextBlock Text="{Binding FormattedCompressedSize}" FontSize="8.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#4ADE8018" CornerRadius="10" Padding="6,2.5" Margin="4,0" BorderBrush="#4ADE8030" BorderThickness="0.5">
                                                <TextBlock Text="{Binding PercentSaved, StringFormat='-{0:F0}%'}" FontSize="9" FontWeight="Bold" Foreground="#4ADE80"/>
                                            </Border>

                                            <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" Click="OpenFolder_Click" Tag="{Binding OutputPath}">
                                                <Border Background="#FFFFFF0A" CornerRadius="4" Padding="6,3" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                                    <TextBlock Text="Open" FontSize="9" Foreground="#A0A0B0"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- ━━━━━━━━━━━━ SETTINGS TAB ━━━━━━━━━━━━ -->
                <StackPanel x:Name="SettingsTabPanel" Spacing="10" IsVisible="False">

                    <!-- Theme Accent Color — macOS-Style Swatch Circles -->
                    <Border Background="#FFFFFF06" CornerRadius="10" Padding="14" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Theme Accent Color" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                <TextBlock x:Name="ThemeColorLabel" Text="Cyan" FontSize="10" FontWeight="SemiBold" Foreground="#00D2FF"/>
                            </Grid>

                            <!-- Native macOS-Style Color Swatch Circles -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <Button x:Name="ColorBallCyan" Width="28" Height="28" CornerRadius="14" Background="#00D2FF" BorderBrush="#FFFFFF" BorderThickness="2" Padding="0" Click="ThemeCyan_Click"/>
                                <Button x:Name="ColorBallEmerald" Width="22" Height="22" CornerRadius="11" Background="#00E676" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeEmerald_Click"/>
                                <Button x:Name="ColorBallPurple" Width="22" Height="22" CornerRadius="11" Background="#A855F7" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemePurple_Click"/>
                                <Button x:Name="ColorBallSunset" Width="22" Height="22" CornerRadius="11" Background="#FF9500" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeSunset_Click"/>
                                <Button x:Name="ColorBallRose" Width="22" Height="22" CornerRadius="11" Background="#FF2D55" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeRose_Click"/>
                                <Button x:Name="ColorBallBlue" Width="22" Height="22" CornerRadius="11" Background="#007AFF" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeBlue_Click"/>
                                <!-- Custom Color Wheel -->
                                <Button x:Name="ColorBallCustom" Width="22" Height="22" CornerRadius="11" Padding="0" Click="ThemeCustom_Click" BorderBrush="Transparent" BorderThickness="0">
                                    <Button.Background>
                                        <ConicGradientBrush Center="50%,50%">
                                            <GradientStop Color="#FF0000" Offset="0.0"/>
                                            <GradientStop Color="#FFFF00" Offset="0.17"/>
                                            <GradientStop Color="#00FF00" Offset="0.33"/>
                                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                                            <GradientStop Color="#0000FF" Offset="0.67"/>
                                            <GradientStop Color="#FF00FF" Offset="0.83"/>
                                            <GradientStop Color="#FF0000" Offset="1.0"/>
                                        </ConicGradientBrush>
                                    </Button.Background>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Personalize highlight colors, buttons, and glow indicators." FontSize="8.5" Foreground="#55556A"/>
                        </StackPanel>
                    </Border>

                    <!-- Save Destination & Suffix -->
                    <Border Background="#FFFFFF06" CornerRadius="10" Padding="14" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Save Destination" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filename Suffix" FontSize="9.5" Foreground="#6B6B78"/>
                                <TextBox x:Name="SettingsSuffixBox" Text="_squeezed" Background="#FFFFFF0A" Foreground="#E8E8ED" BorderBrush="#FFFFFF14" CornerRadius="6" Padding="8,5"/>
                            </StackPanel>
                            <CheckBox x:Name="ReplaceOriginalCheck" Content="Replace original file (destructive)" FontSize="10" Foreground="#A0A0B0"/>
                            <CheckBox x:Name="StripMetadataCheck" Content="Strip EXIF &amp; GPS location metadata" IsChecked="True" FontSize="10" Foreground="#A0A0B0"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Squeeze Watch Folder -->
                    <Border Background="#FFFFFF06" CornerRadius="10" Padding="14" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Auto-Squeeze Watch Folder" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Click="AddWatchedFolder_Click">
                                    <Border Background="#FFFFFF0A" CornerRadius="12" Padding="8,3" BorderBrush="#FFFFFF14" BorderThickness="0.5">
                                        <TextBlock Text="+ Add Folder" FontSize="9" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                    </Border>
                                </Button>
                            </Grid>
                            <TextBlock Text="Monitors folder and automatically compresses any new media file." FontSize="8.5" Foreground="#55556A"/>

                            <ItemsControl x:Name="WatchedFoldersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <Border Background="#FFFFFF06" CornerRadius="6" Padding="8,5" Margin="0,2" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" FontSize="9" Foreground="#A0A0B0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Consolas, 'Courier New', monospace"/>
                                                <Button Grid.Column="1" Content="✕" FontSize="9" Background="Transparent" Foreground="#55556A" Padding="3,2" Click="RemoveWatchedFolder_Click" Tag="{Binding}" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyWatchedHint" Text="No watched folders configured" FontSize="9" Foreground="#44444F" TextAlignment="Center" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Lifetime Storage Metrics -->
                    <Border Background="#FFFFFF06" CornerRadius="10" Padding="14" BorderBrush="#FFFFFF0E" BorderThickness="0.5">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Lifetime Storage Metrics" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="TOTAL SPACE SAVED" FontSize="8" FontWeight="Bold" Foreground="#55556A"/>
                                    <TextBlock x:Name="LifetimeSavedText" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#00D2FF"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="FILES OPTIMIZED" FontSize="8" FontWeight="Bold" Foreground="#55556A"/>
                                    <TextBlock x:Name="LifetimeFilesText" Text="0 files" FontSize="16" FontWeight="Bold" Foreground="#E8E8ED"/>
                                </StackPanel>
                            </Grid>
                            <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="ResetStats_Click">
                                <Border Background="#FF525218" CornerRadius="10" Padding="7,3" BorderBrush="#FF525230" BorderThickness="0.5">
                                    <TextBlock Text="Reset Statistics" FontSize="9" Foreground="#EF5350"/>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 4. FOOTER — Minimal Status Bar                      -->
        <!-- ════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Padding="20,6,20,8" BorderBrush="#FFFFFF0A" BorderThickness="0,0.5,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="SavedStatsText" Text="0 MB Saved" FontSize="9" FontWeight="SemiBold" Foreground="#00D2FF"/>
                    <TextBlock Text="·" FontSize="9" Foreground="#44444F"/>
                    <TextBlock x:Name="FooterStatusText" Text="Ready" FontSize="9" Foreground="#55556A"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v0.98" FontSize="9" Foreground="#33333E"/>
            </Grid>
        </Border>
    </Grid>
</Window>
