<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SqueezeBar.Models"
        xmlns:services="clr-namespace:SqueezeBar.Services"
        x:Class="SqueezeBar.Views.MainWindow"
        Title="SqueezeBar - Universal Media Optimizer"
        Width="440" Height="680"
        CanResize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="#121316"
        Foreground="White">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12,16,12">
        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="#00D2FF">
                    <TextBlock Text="S" FontWeight="Bold" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="1">
                    <TextBlock Text="SqueezeBar" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Universal Media Optimizer" FontSize="9" Foreground="#888888"/>
                </StackPanel>
                <Border Background="#1C2028" CornerRadius="10" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedStatsText" Text="0 MB Saved" FontSize="10" FontWeight="SemiBold" Foreground="#00D2FF"/>
                </Border>
            </StackPanel>

            <!-- Top Action Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Status Badge -->
                <Border x:Name="ProcessingBadge" Background="#162E2A" CornerRadius="10" Padding="6,2" IsVisible="False">
                    <TextBlock Text="Optimizing..." FontSize="9.5" FontWeight="SemiBold" Foreground="#00E676"/>
                </Border>
                <Button Content="Floating Ball" FontSize="10" FontWeight="SemiBold" Background="#20242E" Foreground="#CCCCCC" CornerRadius="6" Padding="8,4" Click="ToggleFloatingBall_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. Tab Selector (Activity vs Settings) -->
        <Border Grid.Row="1" Background="#181A20" CornerRadius="20" Padding="3" Margin="0,0,0,12" BorderBrush="#262932" BorderThickness="1">
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" x:Name="ActivityTabBtn" Content="⚡ Activity" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" FontWeight="Bold" Background="#00D2FF" Foreground="Black" CornerRadius="16" Padding="0,5" Click="ActivityTab_Click"/>
                <Button Grid.Column="1" x:Name="SettingsTabBtn" Content="⚙ Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" FontWeight="SemiBold" Background="Transparent" Foreground="#8E9297" CornerRadius="16" Padding="0,5" Click="SettingsTab_Click"/>
            </Grid>
        </Border>

        <!-- 3. Tab Content Body -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12">
                <!-- ==================== ACTIVITY TAB CONTENT ==================== -->
                <StackPanel x:Name="ActivityTabPanel" Spacing="12">
                    <!-- 4 Live Category Profile Tiles -->
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- 1. Images Tile -->
                        <Button Grid.Column="0" x:Name="ImagesTileBtn" Margin="0,0,3,0" Padding="0" Background="Transparent" BorderThickness="0" Click="SelectImagesCategory_Click">
                            <Border x:Name="ImagesTileBorder" Background="#181A20" BorderBrush="#00D2FF" BorderThickness="1.5" CornerRadius="8" Padding="6,7">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Images" FontSize="10" FontWeight="Bold" Foreground="#00D2FF"/>
                                        <TextBlock Grid.Column="1" x:Name="ImagesChevron" Text="▲" FontSize="8" Foreground="#00D2FF"/>
                                    </Grid>
                                    <TextBlock x:Name="ImagesTileSummary" Text="WebP • 80% Q" FontSize="8.5" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 2. Video Tile -->
                        <Button Grid.Column="1" x:Name="VideoTileBtn" Margin="2,0,2,0" Padding="0" Background="Transparent" BorderThickness="0" Click="SelectVideoCategory_Click">
                            <Border x:Name="VideoTileBorder" Background="#181A20" BorderBrush="#262932" BorderThickness="1" CornerRadius="8" Padding="6,7">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Video" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Grid.Column="1" x:Name="VideoChevron" Text="▼" FontSize="8" Foreground="#666666"/>
                                    </Grid>
                                    <TextBlock x:Name="VideoTileSummary" Text="HEVC • 70% Q" FontSize="8.5" Foreground="#8E9297" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 3. Audio Tile -->
                        <Button Grid.Column="2" x:Name="AudioTileBtn" Margin="2,0,2,0" Padding="0" Background="Transparent" BorderThickness="0" Click="SelectAudioCategory_Click">
                            <Border x:Name="AudioTileBorder" Background="#181A20" BorderBrush="#262932" BorderThickness="1" CornerRadius="8" Padding="6,7">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Audio" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Grid.Column="1" x:Name="AudioChevron" Text="▼" FontSize="8" Foreground="#666666"/>
                                    </Grid>
                                    <TextBlock x:Name="AudioTileSummary" Text="192 kbps" FontSize="8.5" Foreground="#8E9297" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 4. PDF Tile -->
                        <Button Grid.Column="3" x:Name="PdfTileBtn" Margin="3,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Click="SelectPdfCategory_Click">
                            <Border x:Name="PdfTileBorder" Background="#181A20" BorderBrush="#262932" BorderThickness="1" CornerRadius="8" Padding="6,7">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Grid.Column="1" x:Name="PdfChevron" Text="▼" FontSize="8" Foreground="#666666"/>
                                    </Grid>
                                    <TextBlock x:Name="PdfTileSummary" Text="150 DPI" FontSize="8.5" Foreground="#8E9297" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Collapsible Format Configuration Drawer / Deck -->
                    <Border x:Name="FormatDrawerBorder" Background="#181A20" CornerRadius="10" Padding="12" BorderBrush="#262A33" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <!-- Quick Presets Limit Bar -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="TARGET SIZE PRESET LIMIT" FontSize="9" FontWeight="Bold" Foreground="#888888"/>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" x:Name="PresetOffBtn" Content="Off" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9.5" Background="#20242E" Foreground="#CCCCCC" CornerRadius="4" Padding="0,3" Click="PresetOff_Click"/>
                                    <Button Grid.Column="1" x:Name="Preset25Btn" Content="25MB (Discord)" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9.5" FontWeight="Bold" Background="#00D2FF" Foreground="Black" CornerRadius="4" Padding="0,3" Click="Preset25_Click"/>
                                    <Button Grid.Column="2" x:Name="Preset10Btn" Content="10MB (Email)" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9.5" Background="#20242E" Foreground="#CCCCCC" CornerRadius="4" Padding="0,3" Click="Preset10_Click"/>
                                    <Button Grid.Column="3" x:Name="Preset50Btn" Content="50MB (Nitro)" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9.5" Background="#20242E" Foreground="#CCCCCC" CornerRadius="4" Padding="0,3" Click="Preset50_Click"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="#22252E"/>

                            <!-- Images Configuration Deck -->
                            <StackPanel x:Name="ImagesDeckPanel" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Image Quality" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                    <TextBlock Grid.Column="1" x:Name="ImgQualityLabel" Text="80%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF"/>
                                </Grid>
                                <Slider x:Name="ImgQualitySlider" Minimum="0.10" Maximum="1.0" Value="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,-4,0,-4"/>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="3">
                                        <TextBlock Text="Format" FontSize="9.5" Foreground="#888888"/>
                                        <ComboBox x:Name="ImgFormatCombo" HorizontalAlignment="Stretch" FontSize="10">
                                            <ComboBoxItem Content="Modern WebP"/>
                                            <ComboBoxItem Content="Web JPEG"/>
                                            <ComboBoxItem Content="Preserve Original"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="3">
                                        <TextBlock Text="Scale" FontSize="9.5" Foreground="#888888"/>
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" Content="100%" Margin="0,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ImgScale100_Click"/>
                                            <Button Grid.Column="1" Content="75%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ImgScale75_Click"/>
                                            <Button Grid.Column="2" Content="50%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ImgScale50_Click"/>
                                            <Button Grid.Column="3" Content="25%" Margin="1,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ImgScale25_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Video Configuration Deck -->
                            <StackPanel x:Name="VideoDeckPanel" Spacing="8" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Video Quality / CRF" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                    <TextBlock Grid.Column="1" x:Name="VidQualityLabel" Text="70%" FontSize="10" FontWeight="Bold" Foreground="#00D2FF"/>
                                </Grid>
                                <Slider x:Name="VidQualitySlider" Minimum="0.10" Maximum="1.0" Value="0.70" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,-4,0,-4"/>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="3">
                                        <TextBlock Text="Video Codec" FontSize="9.5" Foreground="#888888"/>
                                        <ComboBox x:Name="VidCodecCombo" HorizontalAlignment="Stretch" FontSize="10">
                                            <ComboBoxItem Content="HEVC (H.265)"/>
                                            <ComboBoxItem Content="H.264"/>
                                            <ComboBoxItem Content="Animated GIF"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="3">
                                        <TextBlock Text="Scale" FontSize="9.5" Foreground="#888888"/>
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" Content="100%" Margin="0,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="VidScale100_Click"/>
                                            <Button Grid.Column="1" Content="75%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="VidScale75_Click"/>
                                            <Button Grid.Column="2" Content="50%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="VidScale50_Click"/>
                                            <Button Grid.Column="3" Content="25%" Margin="1,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="VidScale25_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Audio Configuration Deck -->
                            <StackPanel x:Name="AudioDeckPanel" Spacing="8" IsVisible="False">
                                <TextBlock Text="Audio Bitrate" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                <ComboBox x:Name="AudioBitrateCombo" HorizontalAlignment="Stretch" FontSize="10">
                                    <ComboBoxItem Content="64 kbps (Voice / Podcast)"/>
                                    <ComboBoxItem Content="128 kbps (Standard Quality)"/>
                                    <ComboBoxItem Content="192 kbps (High Quality AAC)"/>
                                    <ComboBoxItem Content="256 kbps (Studio Quality)"/>
                                    <ComboBoxItem Content="320 kbps (Maximum Fidelity)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- PDF Configuration Deck -->
                            <StackPanel x:Name="PdfDeckPanel" Spacing="8" IsVisible="False">
                                <TextBlock Text="PDF Target Resolution (DPI)" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Content="72 DPI" Margin="0,0,2,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="PdfDpi72_Click"/>
                                    <Button Grid.Column="1" Content="150 DPI" Margin="2,0,2,0" FontSize="9" FontWeight="Bold" Background="#00D2FF" Foreground="Black" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="PdfDpi150_Click"/>
                                    <Button Grid.Column="2" Content="200 DPI" Margin="2,0,2,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="PdfDpi200_Click"/>
                                    <Button Grid.Column="3" Content="300 DPI" Margin="2,0,0,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="PdfDpi300_Click"/>
                                </Grid>
                                <CheckBox x:Name="PdfGrayscaleCheck" Content="Convert to Grayscale (B&amp;W Document)" FontSize="10" Foreground="#CCCCCC"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick Squeeze Card (Instant Drop Zone) -->
                    <Border x:Name="QuickDropBorder"
                            Background="#181A20"
                            BorderBrush="#00D2FF"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="14"
                            DragDrop.AllowDrop="True">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Border Background="#20242E" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ QUICK SQUEEZE" FontSize="10" FontWeight="Bold" Foreground="#00D2FF"/>
                            </Border>
                            <TextBlock Text="Drop files here for instant 1-drop compression" FontSize="11" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Border Background="#121316" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="QuickDropLimitPill" Text="Limit: 25MB" FontSize="9" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                </Border>
                                <Border Background="#121316" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="WebP • HEVC • JPG • PDF" FontSize="9" Foreground="#8E9297"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Custom Staged Queue Section (Lower Zone) -->
                    <Border Background="#181A20"
                            BorderBrush="#262A33"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            DragDrop.AllowDrop="True"
                            x:Name="StagedQueueBorder">
                        <StackPanel Spacing="8">
                            <!-- Queue Header -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock x:Name="QueueHeaderTitle" Text="Staged Queue (0)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Clear" FontSize="10" Background="Transparent" Foreground="#888888" Margin="0,0,6,0" Click="ClearQueue_Click"/>
                                <Button Grid.Column="2" x:Name="SqueezeAllBtn" Content="Squeeze All" FontSize="10" FontWeight="Bold" Background="#00D2FF" Foreground="Black" CornerRadius="6" Padding="10,4" Click="SqueezeAll_Click"/>
                            </Grid>

                            <!-- Staged List Items -->
                            <ItemsControl x:Name="StagedQueueItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:StagedQueueItem">
                                        <Border Background="#121316" CornerRadius="6" Padding="8,6" Margin="0,2" BorderBrush="#20232B" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CustomSettingSummary}" FontSize="9.5" Foreground="#00D2FF"/>
                                                </StackPanel>

                                                <!-- Custom Button -->
                                                <Button Grid.Column="1" Content="Custom" FontSize="9.5" FontWeight="SemiBold" Background="#20242E" Foreground="White" CornerRadius="4" Padding="6,2" Margin="4,0" Click="CustomizeItem_Click" Tag="{Binding}"/>
                                                <!-- Delete Button -->
                                                <Button Grid.Column="2" Content="✕" FontSize="9.5" Background="Transparent" Foreground="#666666" Padding="4,2" Click="DeleteItem_Click" Tag="{Binding Id}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="EmptyQueueHint" Text="Drag files here to customize individual per-file settings" FontSize="10" Foreground="#555555" TextAlignment="Center" Margin="0,6"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Processing Jobs Section -->
                    <Border x:Name="ActiveJobsBorder" Background="#181A20" CornerRadius="10" Padding="12" BorderBrush="#262A33" BorderThickness="1" IsVisible="False">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CURRENT PROCESSING" FontSize="10" FontWeight="Bold" Foreground="#00D2FF"/>
                                <Button Grid.Column="1" Content="Cancel All" FontSize="9" Background="Transparent" Foreground="#FF5252" Click="CancelAllJobs_Click"/>
                            </Grid>
                            
                            <ItemsControl x:Name="ActiveJobsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:CompressionJob">
                                        <Border Background="#121316" CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="4" Background="#20232B" Foreground="#00D2FF" CornerRadius="2"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1C2028" CornerRadius="4" Padding="4,2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="#00D2FF"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="✕" FontSize="9" Background="Transparent" Foreground="#666666" Click="CancelSingleJob_Click" Tag="{Binding Id}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Recent Squeezes History List -->
                    <Border Background="#181A20" CornerRadius="10" Padding="12" BorderBrush="#262A33" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Recent Squeezes" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            
                            <ItemsControl x:Name="HistoryItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:CompressionResult">
                                        <Border Background="#121316" CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding FormattedOriginalSize}" FontSize="9" Foreground="#666666"/>
                                                        <TextBlock Text="→" FontSize="9" Foreground="#666666"/>
                                                        <TextBlock Text="{Binding FormattedCompressedSize}" FontSize="9" FontWeight="Bold" Foreground="#00D2FF"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="#162E2A" CornerRadius="4" Padding="5,2" Margin="4,0">
                                                    <TextBlock Text="{Binding PercentSaved, StringFormat='-{0:F0}%'}" FontSize="9" FontWeight="Bold" Foreground="#00E676"/>
                                                </Border>

                                                <Button Grid.Column="2" Content="Open" FontSize="9.5" Background="#20242E" Foreground="#CCCCCC" CornerRadius="4" Padding="6,2" Click="OpenFolder_Click" Tag="{Binding OutputPath}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== SETTINGS TAB CONTENT ==================== -->
                <StackPanel x:Name="SettingsTabPanel" Spacing="14" IsVisible="False">
                    <!-- Accent Color Theme Picker -->
                    <Border Background="#181A20" CornerRadius="10" Padding="12" BorderBrush="#262A33" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Theme Accent Color" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            <Grid ColumnDefinitions="*,*,*,*,*">
                                <Button Grid.Column="0" Content="Cyan" Margin="0,0,2,0" Background="#00D2FF" Foreground="Black" FontWeight="Bold" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemeCyan_Click"/>
                                <Button Grid.Column="1" Content="Emerald" Margin="2,0,2,0" Background="#00E676" Foreground="Black" FontWeight="Bold" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemeEmerald_Click"/>
                                <Button Grid.Column="2" Content="Purple" Margin="2,0,2,0" Background="#A855F7" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemePurple_Click"/>
                                <Button Grid.Column="3" Content="Sunset" Margin="2,0,2,0" Background="#FF6B00" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemeSunset_Click"/>
                                <Button Grid.Column="4" Content="Blue" Margin="2,0,0,0" Background="#007AFF" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemeBlue_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Output File Naming & Location -->
                    <Border Background="#181A20" CornerRadius="10" Padding="12" BorderBrush="#262A33" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="File Naming &amp; Output" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filename Suffix" FontSize="10" Foreground="#888888"/>
                                <TextBox x:Name="SettingsSuffixBox" Text="_squeezed" Background="#121316" Foreground="White" BorderBrush="#262932"/>
                            </StackPanel>
                            <CheckBox x:Name="ReplaceOriginalCheck" Content="Replace original file (destructive)" FontSize="10.5" Foreground="#CCCCCC"/>
                            <CheckBox x:Name="StripMetadataCheck" Content="Strip EXIF &amp; GPS Location Privacy Metadata" IsChecked="True" FontSize="10.5" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </Border>

                    <!-- Watched Folders Manager -->
                    <Border Background="#181A20" CornerRadius="10" Padding="12" BorderBrush="#262A33" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Watched Folders (Auto-Squeeze)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Add Folder" FontSize="9.5" FontWeight="SemiBold" Background="#20242E" Foreground="#00D2FF" CornerRadius="4" Padding="6,2" Click="AddWatchedFolder_Click"/>
                            </Grid>
                            <TextBlock Text="Any media dropped into these folders will be automatically compressed." FontSize="9.5" Foreground="#888888"/>
                            
                            <ItemsControl x:Name="WatchedFoldersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <Border Background="#121316" CornerRadius="6" Padding="6,4" Margin="0,2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" FontSize="9.5" Foreground="#CCCCCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="✕" FontSize="9" Background="Transparent" Foreground="#666666" Click="RemoveWatchedFolder_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyWatchedHint" Text="No watched folders configured" FontSize="9.5" Foreground="#555555" TextAlignment="Center" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Lifetime Statistics & Reset -->
                    <Border Background="#181A20" CornerRadius="10" Padding="12" BorderBrush="#262A33" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Lifetime Storage Metrics" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOTAL SPACE SAVED" FontSize="8.5" Foreground="#888888"/>
                                    <TextBlock x:Name="LifetimeSavedText" Text="0 MB" FontSize="14" FontWeight="Bold" Foreground="#00D2FF"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FILES OPTIMIZED" FontSize="8.5" Foreground="#888888"/>
                                    <TextBlock x:Name="LifetimeFilesText" Text="0 files" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Reset Lifetime Statistics" FontSize="9" Background="#20242E" Foreground="#FF5252" CornerRadius="4" Padding="6,3" HorizontalAlignment="Right" Click="ResetStats_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="0,4,0,0" BorderBrush="#262930" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="FooterStatusText" Text="Ready • Drop media to squeeze" FontSize="9.5" Foreground="#666666"/>
                <TextBlock Grid.Column="1" Text="v0.98 Windows Edition" FontSize="9.5" Foreground="#444444"/>
            </Grid>
        </Border>
    </Grid>
</Window>
