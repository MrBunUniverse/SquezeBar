<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqueezeBar.Views.SettingsDialog"
        Title="SqueezeBar Settings"
        Width="380" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#14161B"
        Foreground="White">

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="#252830" BorderThickness="0,0,0,1">
            <StackPanel Spacing="3">
                <TextBlock Text="Compression Preferences" FontWeight="Bold" FontSize="14" Foreground="White"/>
                <TextBlock Text="Configure default compression behavior and presets" FontSize="11" Foreground="#8E9297"/>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- 1. Default Image Quality -->
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Default Image Quality" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <TextBlock Grid.Column="1" x:Name="QualityValueLabel" Text="80%" FontSize="11" FontWeight="Bold" Foreground="#00D2FF"/>
                    </Grid>
                    <Slider x:Name="QualitySlider" Minimum="0.10" Maximum="1.0" Value="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <!-- 2. Default Image Format -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Default Image Format Policy" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <ComboBox x:Name="ImageFormatBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Preserve Original Format"/>
                        <ComboBoxItem Content="Convert to Modern WebP"/>
                        <ComboBoxItem Content="Convert to Web JPEG"/>
                    </ComboBox>
                </StackPanel>

                <!-- 3. Default Video Codec -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Default Video Codec" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <ComboBox x:Name="VideoCodecBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="HEVC (H.265) - Hardware Efficient"/>
                        <ComboBoxItem Content="H.264 - Universal Compatibility"/>
                        <ComboBoxItem Content="Animated GIF"/>
                    </ComboBox>
                </StackPanel>

                <!-- 4. Default Target Size Limit -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Target Size Limit Preset" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <ComboBox x:Name="TargetSizeBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Off (Maximum Compression)"/>
                        <ComboBoxItem Content="25MB (Discord Free Upload Limit)"/>
                        <ComboBoxItem Content="10MB (Standard Email Attachment)"/>
                        <ComboBoxItem Content="50MB (Discord Nitro Classic)"/>
                    </ComboBox>
                </StackPanel>

                <!-- 5. Output Filename Suffix -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Output Filename Suffix" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <TextBox x:Name="SuffixTextBox" Text="_squeezed" Background="#1B1E26" Foreground="White" BorderBrush="#2E323D"/>
                </StackPanel>

                <!-- 6. Privacy: Strip Metadata -->
                <CheckBox x:Name="StripMetadataCheck" Content="Strip EXIF, Camera &amp; Location Metadata" IsChecked="True" FontSize="11" Foreground="#CCCCCC"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#252830" BorderThickness="0,1,0,0">
            <Button Content="Save &amp; Close" HorizontalAlignment="Right" Background="#00D2FF" Foreground="Black" FontWeight="Bold" Padding="18,7" CornerRadius="6" Click="SaveButton_Click"/>
        </Border>
    </Grid>
</Window>
